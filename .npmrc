# 本机 pnpm 默认的符号链接模式在创建 vitepress 依赖链接时失败
# （UNKNOWN: unknown error, open '.../node_modules/vitepress/package.json'），
# 改用扁平化的 node_modules 结构规避。
# 仅影响依赖在磁盘上的组织方式，不改变 lockfile、构建产物与部署流程。
node-linker=hoisted

# store/cache 圈定在项目内（node_modules 已被 git 忽略），避免触碰系统全局路径
store-dir=node_modules/.pnpm-store
cache-dir=node_modules/.pnpm-cache
